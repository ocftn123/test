function grade(){{
 let score=0,unanswered=0;const cards=[...document.querySelectorAll(".card")];
 cards.forEach(c=>{{
  const chosen=c.querySelector("input:checked"),labels=c.querySelectorAll(".opt"),ans=c.dataset.answer;
  labels.forEach(x=>x.classList.remove("correct","wrong"));
  if(!chosen)unanswered++;else if(chosen.value===ans){{score++;chosen.parentElement.classList.add("correct");}}else chosen.parentElement.classList.add("wrong");
  labels.forEach(x=>{{if(x.querySelector("input").value===ans)x.classList.add("correct");}});
  const d=c.querySelector(".detail");d.style.display="block";d.innerHTML=`정답: <strong>${{esc(ans)}}</strong> · 단어: <strong>${{esc(c.dataset.word)}}</strong>`;
 }});
 const pct=Math.round(score/cards.length*100),r=document.getElementById("result");
 r.innerHTML=`<div class="stats">${{score}} / ${{cards.length}} · ${{pct}}점</div>미응답 ${{unanswered}}개`;
 r.style.display="block";window.scrollTo({{top:0,behavior:"smooth"}});
}}
render();
</script></body></html>"""

