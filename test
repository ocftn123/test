questions=[]
for w in words:
    # type 1
    others=[meaning[x] for x in words if x!=w]; random.shuffle(others)
    opts=[meaning[w]]+others[:4]; random.shuffle(opts)
    questions.append({"type":"EN-KO","word":w,"prompt":w,"options":opts,"answer":meaning[w]})
    # type 2
    others=[x for x in words if x!=w]; random.shuffle(others)
    opts=[w]+others[:4]; random.shuffle(opts)
    questions.append({"type":"KO-EN","word":w,"prompt":meaning[w],"options":opts,"answer":w})
    # type 3
    others=[x for x in words if x!=w]; random.shuffle(others)
    opts=[w]+others[:4]; random.shuffle(opts)
    questions.append({"type":"CLOZE","word":w,"prompt":contexts[w],"options":opts,"answer":w})
    # type 4
    p,opts,ans=relations[w]
    random.shuffle(opts)
    questions.append({"type":"RELATION","word":w,"prompt":p,"options":opts,"answer":ans})

payload=json.dumps(questions,ensure_ascii=False)

